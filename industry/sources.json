    {
      "id": "web-cn-stats-latest",
      "name": "国家统计局 · 最新发布",
      "kind": "web_list",
      "config": {
        "url": "https://www.stats.gov.cn/szst/",
        "parseMode": "html",
        "allowUrlPrefixes": [
          "https://www.stats.gov.cn/sj/zxfb/"
        ],
        "detail": {
          "maxFetches": 20
        },
        "_aihot": {
          "initialBackfillLimit": 12
        }
      },
      "tier": "T1",
      "owner_entity_id": null,
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "官方",
